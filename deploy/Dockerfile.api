# syntax=docker/dockerfile:1
# Quantitize Platform — API / Worker / Pipeline（GPU）
# 基于已验证的 gray1 量化运行时（Ultralytics 8.3.98，输入 1 通道）。
#
# 在 quantitize-platform 根目录构建：
#   docker build -f deploy/Dockerfile.api -t quantitize-platform-api:latest .
#
# 旧 21GB conda yolov8（8.4.6 / 3 通道）镜像已打标签
#   quantitize-platform-api:pre-gray1-20260910

FROM ywang/yolo-gray1-quant:ultralytics-8.3.98-v6

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PLATFORM_ROOT=/home/rs/wrs/onnxviewe/quantitize-platform \
    OUTPUT_DATA_ROOT=/home/rs/wrs/onnxviewe/quantitize-platform/data/output_data \
    SHARED_DATA_ROOT=/home/rs/wrs/onnxviewe/quantitize-platform/data/shared_data \
    YOLOV8_PYTHON=/opt/ywang/yolo-runtime/bin/python \
    CONDA_PREFIX=/opt/ywang/yolo-runtime \
    PATH=/opt/ywang/yolo-runtime/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONPATH=/workspace/src/Yolo_fine/ultralytics \
    YOLO_INPUT_CHANNELS=1 \
    YOLO_INPUT_SEMANTICS=gray1 \
    YOLO_IMGSZ=1280 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PORT=8000

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/rs/wrs/onnxviewe/quantitize-platform
COPY apps/api/requirements.txt /tmp/api-requirements.txt
RUN /opt/ywang/yolo-runtime/bin/python -m pip install --no-cache-dir -r /tmp/api-requirements.txt \
    && rm -f /tmp/api-requirements.txt

COPY apps/api/ /home/rs/wrs/onnxviewe/quantitize-platform/apps/api/
COPY pipeline/ /home/rs/wrs/onnxviewe/quantitize-platform/pipeline/
COPY patches/ /home/rs/wrs/onnxviewe/quantitize-platform/patches/
RUN mkdir -p data/output_data data/shared_data \
    && touch data/output_data/.gitkeep data/shared_data/.gitkeep

EXPOSE 8000
CMD ["/opt/ywang/yolo-runtime/bin/python", "-m", "uvicorn", \
     "apps.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
